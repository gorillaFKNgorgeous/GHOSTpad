+++ b/intern/ghost/intern/GHOST_SystemIOS.mm
@@ -1,4 +1,52 @@
 @end
+
+static NSObject *s_metalRedrawLogLock = [[NSObject alloc] init];
+
+static NSURL *ghost_ios_metal_redraw_log_url()
+{
+  NSURL *documentsURL =
+      [[[NSFileManager defaultManager] URLsForDirectory:NSDocumentDirectory
+                                              inDomains:NSUserDomainMask] firstObject];
+  return [documentsURL URLByAppendingPathComponent:@"BlenderMetalRedraw.log"];
+}
+
+static void ghost_ios_log_metal_redraw(NSString *event, MTKView *view)
+{
+  @autoreleasepool {
+    NSString *line = [NSString
+        stringWithFormat:@"%@ | event=%@ main=%@ paused=%@ enableSetNeedsDisplay=%@ "
+                         "drawable=%@ available=%llu\n",
+                         [[NSDate date] descriptionWithLocale:nil],
+                         event ?: @"unknown",
+                         [NSThread isMainThread] ? @"yes" : @"no",
+                         view ? (view.paused ? @"yes" : @"no") : @"n/a",
+                         view ? (view.enableSetNeedsDisplay ? @"yes" : @"no") : @"n/a",
+                         view ? NSStringFromCGSize(view.drawableSize) : @"<nil>",
+                         (unsigned long long)os_proc_available_memory()];
+
+    @synchronized(s_metalRedrawLogLock) {
+      NSURL *logURL = ghost_ios_metal_redraw_log_url();
+      NSData *data = [line dataUsingEncoding:NSUTF8StringEncoding];
+      if (!logURL || !data) {
+        return;
+      }
+
+      NSFileManager *fileManager = [NSFileManager defaultManager];
+      if (![fileManager fileExistsAtPath:logURL.path]) {
+        [fileManager createFileAtPath:logURL.path contents:nil attributes:nil];
+      }
+
+      NSError *error = nil;
+      NSFileHandle *handle = [NSFileHandle fileHandleForWritingToURL:logURL error:&error];
+      if (!handle) {
+        return;
+      }
+      [handle seekToEndOfFile];
+      [handle writeData:data];
+      [handle closeFile];
+    }
+  }
+}
 
