+/* Diagnostic only: no cache repair, skipped work, or changed ownership. */
+static void ios_pass_cache_trace(const char *event, const void *cache, const void *pass = nullptr)
+{
+  const char *home = getenv("HOME");
+  if (!home) {
+    return;
+  }
+  char path[4096];
+  const int length = snprintf(path, sizeof(path), "%s/Documents/BlenderRenderCache.log", home);
+  if (length < 0 || size_t(length) >= sizeof(path)) {
+    return;
+  }
+  uint64_t tid = 0;
+  pthread_threadid_np(nullptr, &tid);
+  task_vm_info_data_t vm = {};
+  mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+  const kern_return_t status = task_info(mach_task_self(), TASK_VM_INFO,
+                                         reinterpret_cast<task_info_t>(&vm), &count);
+  timeval now = {};
+  gettimeofday(&now, nullptr);
+  if (FILE *file = fopen(path, "a")) {
+    fprintf(file, "%lld.%06d pid=%d tid=%llu event=%s cache=%p pass=%p "
+                  "footprint=%llu available=%llu task_info=%d\n",
+            static_cast<long long>(now.tv_sec), int(now.tv_usec), int(getpid()),
+            static_cast<unsigned long long>(tid), event, cache, pass,
+            status == KERN_SUCCESS ? static_cast<unsigned long long>(vm.phys_footprint) : 0ULL,
+            static_cast<unsigned long long>(os_proc_available_memory()), int(status));
+    fflush(file);
+    fsync(fileno(file));
+    fclose(file);
+  }
+}
+#endif
 
